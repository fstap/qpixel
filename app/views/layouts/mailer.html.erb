<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title><%= message.subject %></title>
  <%= stylesheet_link_tag 'https://cdn.jsdelivr.net/npm/@codidact/co-design@latest/dist/codidact.css' %>
  <%= stylesheet_link_tag 'application', media: 'all' %>
</head>
<body>
<div class="header">
  <div class="container header--container">
    <%= link_to root_url, class: 'header--site-name' do %>
      <%= image_tag asset_path('codidact.png', host: 'meta.codidact.com', protocol: 'https'), height: 40, width: 167,
                    alt: 'Codidact logo' %>
    <% end %>
  </div>
</div>
<div class="container">
  <%= yield %>
</div>
</body>
</html>
